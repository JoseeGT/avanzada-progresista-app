# Credenciales y entorno
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ap2026

# Base de datos SQLite del padrón CNE (solo lectura)
PADRON_DB_PATH=padron_cne.db

# Persistencia (Firestore opcional; si no existe, usa archivos JSON locales)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
LOCAL_FALLBACK_PATH=activistas_local.json
LOCAL_ESTRUCTURA_PATH=estructura_local.json
LOCAL_USUARIOS_PATH=usuarios_local.json

# Respaldos automáticos rotativos
BACKUPS_DIR=backups
MAX_AUTO_BACKUPS=15

# Sesiones y seguridad
SESSIONS_FILE_PATH=.sessions_local.json
SESSION_TTL_SECONDS=86400
SESSION_IDLE_SECONDS=3600
LOGIN_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=180
TRUSTED_PROXIES=
